{
  "info": {
    "name": "Library API",
    "description": "API-tests til bibliotek-API'et (del 6). Kør alle fem requests i rækkefølge mod et nystartet API: data ligger kun i hukommelsen, og request 2 og 4 bygger på lånet fra request 1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Opret lån",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status er 201 Created\", () => pm.response.to.have.status(201));",
              "",
              "// Gem kun id'et, når lånet faktisk blev oprettet. Ellers ryddes variablerne,",
              "// så de næste requests ikke bruger værdier fra en tidligere kørsel.",
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set(\"loanId\", pm.response.json().id);",
              "    pm.collectionVariables.set(\"bookIsbn\", pm.response.json().bookIsbn);",
              "} else {",
              "    pm.collectionVariables.unset(\"loanId\");",
              "    pm.collectionVariables.unset(\"bookIsbn\");",
              "}",
              "",
              "pm.test(\"Lånet har de seks felter\", () => {",
              "    pm.expect(pm.response.json()).to.have.all.keys(\"id\", \"memberId\", \"bookIsbn\", \"loanDate\", \"dueDate\", \"returnedDate\");",
              "});",
              "",
              "pm.test(\"Lånet hører til medlem 1 og den ønskede bog\", () => {",
              "    const loan = pm.response.json();",
              "    pm.expect(loan.memberId).to.eql(1);",
              "    pm.expect(loan.bookIsbn).to.eql(\"9780306406157\");",
              "});",
              "",
              "pm.test(\"Afleveringsfristen er 14 dage efter lånedatoen\", () => {",
              "    const loan = pm.response.json();",
              "    const msPerDay = 24 * 60 * 60 * 1000;",
              "    const days = Math.round((new Date(loan.dueDate) - new Date(loan.loanDate)) / msPerDay);",
              "    pm.expect(days).to.eql(14);",
              "});",
              "",
              "pm.test(\"Bogen er ikke afleveret endnu\", () => {",
              "    pm.expect(pm.response.json().returnedDate).to.be.null;",
              "});",
              "",
              "pm.test(\"Location-headeren peger på det nye lån\", () => {",
              "    const id = pm.response.json().id;",
              "    pm.expect(pm.response.headers.get(\"Location\")).to.match(new RegExp(\"/api/loans/\" + id + \"$\", \"i\"));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/loans",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "loans"
          ]
        },
        "description": "Glad vej: medlem 1 låner en ledig bog. Gemmer lånets id og ISBN til de næste requests.",
        "body": {
          "mode": "raw",
          "raw": "{\"memberId\": 1, \"isbn\": \"9780306406157\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "2. Hent lånet",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status er 200 OK\", () => pm.response.to.have.status(200));",
              "",
              "pm.test(\"Det er det lån, der lige blev oprettet\", () => {",
              "    pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"loanId\")));",
              "});",
              "",
              "pm.test(\"bookIsbn er det samme som i POST-svaret\", () => {",
              "    pm.expect(pm.response.json().bookIsbn).to.eql(pm.collectionVariables.get(\"bookIsbn\"));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/loans/{{loanId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "loans",
            "{{loanId}}"
          ]
        },
        "description": "Henter det lån, request 1 oprettede, via den gemte variabel loanId."
      },
      "response": []
    },
    {
      "name": "3. Ugyldigt ISBN",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status er 400 Bad Request\", () => pm.response.to.have.status(400));",
              "",
              "pm.test(\"Fejlsvaret har feltet error med en tekst\", () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property(\"error\");",
              "    pm.expect(body.error).to.be.a(\"string\").and.not.be.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/loans",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "loans"
          ]
        },
        "description": "Fejlvej: ISBN'et er ikke et gyldigt ISBN-13, så API'et skal afvise med 400.",
        "body": {
          "mode": "raw",
          "raw": "{\"memberId\": 1, \"isbn\": \"123\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "4. Bogen er allerede udlånt",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status er 409 Conflict\", () => pm.response.to.have.status(409));",
              "",
              "pm.test(\"Fejlsvaret har feltet error med en tekst\", () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property(\"error\");",
              "    pm.expect(body.error).to.be.a(\"string\").and.not.be.empty;",
              "});",
              "",
              "// 409 bruges også, når medlemmet har 3 lån. Teksten viser, hvilken regel der slog til.",
              "pm.test(\"Årsagen er, at bogen er udlånt\", () => {",
              "    pm.expect(pm.response.json().error).to.include(\"udlånt\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/loans",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "loans"
          ]
        },
        "description": "Fejlvej: samme ISBN som i request 1. Bogen er udlånt, så API'et skal svare 409.",
        "body": {
          "mode": "raw",
          "raw": "{\"memberId\": 1, \"isbn\": \"9780306406157\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "5. Lånet findes ikke",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status er 404 Not Found\", () => pm.response.to.have.status(200));",
              "",
              "// Ved 404 svarer API'et med ASP.NET Cores standardformat (problem details)",
              "// og ikke med feltet error som ved 400 og 409. Testen følger det, API'et gør.",
              "pm.test(\"Fejlsvaret er problem details med status 404\", () => {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
              "    pm.expect(pm.response.json().status).to.eql(404);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/loans/99999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "loans",
            "99999"
          ]
        },
        "description": "Fejlvej: der findes intet lån med id 99999."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "loanId",
      "value": ""
    },
    {
      "key": "bookIsbn",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Kører efter hver request i collectionen.",
          "pm.test(\"Svartid under 500 ms\", () => {",
          "    pm.expect(pm.response.responseTime).to.be.below(500);",
          "});"
        ]
      }
    }
  ]
}
